#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer Results { uint hitCount; };
layout(push_constant) uniform Push { int samples; } pushData;
shared uint localHits[256];
void main() {
    uint globalId = gl_GlobalInvocationID.x;
    uint localId = gl_LocalInvocationID.x;
    uint hit = 0u;
    const uint SAMPLES_PER_INVOCATION = 32u;
    uint baseSample = globalId * SAMPLES_PER_INVOCATION;
    for (uint sampleOffset = 0u; sampleOffset < SAMPLES_PER_INVOCATION; sampleOffset++) {
        uint sampleId = baseSample + sampleOffset;
        if (sampleId >= uint(pushData.samples)) {
            break;
        }
        uint seed = sampleId * 1103515245u + 12345u;
        seed = seed * 1103515245u + 12345u;
        float x = float(seed % 1000000u) / 500000.0 - 1.0;
        seed = seed * 1103515245u + 12345u;
        float y = float(seed % 1000000u) / 500000.0 - 1.0;
        hit += (x * x + y * y <= 1.0) ? 1u : 0u;
    }
    localHits[localId] = hit;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localId < stride) {
            localHits[localId] += localHits[localId + stride];
        }
        barrier();
    }
    if (localId == 0u) {
        atomicAdd(hitCount, localHits[0]);
    }
}
