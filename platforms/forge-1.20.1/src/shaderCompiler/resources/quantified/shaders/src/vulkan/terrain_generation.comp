#version 450
#pragma STDGL no_contraction

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer InCoords { float inputCoords[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OutFeatures { float outputFeatures[]; };
layout(push_constant) uniform Push { int count; } pushData;

uint mixBits(uint x) {
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}

uint coordBits(ivec3 p, uint salt) {
    uint x = uint(p.x) * 0x8da6b343u;
    uint y = uint(p.y) * 0xd8163841u;
    uint z = uint(p.z) * 0xcb1ab31fu;
    return mixBits(x ^ y ^ z ^ salt);
}

float rand01(ivec3 p, uint salt) {
    return float(coordBits(p, salt) & 0x00ffffffu) * (1.0 / 16777215.0);
}

float fade(float t) {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float valueNoise(vec3 p, uint salt) {
    ivec3 i = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 u = vec3(fade(f.x), fade(f.y), fade(f.z));

    float n000 = rand01(i + ivec3(0, 0, 0), salt);
    float n100 = rand01(i + ivec3(1, 0, 0), salt);
    float n010 = rand01(i + ivec3(0, 1, 0), salt);
    float n110 = rand01(i + ivec3(1, 1, 0), salt);
    float n001 = rand01(i + ivec3(0, 0, 1), salt);
    float n101 = rand01(i + ivec3(1, 0, 1), salt);
    float n011 = rand01(i + ivec3(0, 1, 1), salt);
    float n111 = rand01(i + ivec3(1, 1, 1), salt);

    float nx00 = mix(n000, n100, u.x);
    float nx10 = mix(n010, n110, u.x);
    float nx01 = mix(n001, n101, u.x);
    float nx11 = mix(n011, n111, u.x);
    float nxy0 = mix(nx00, nx10, u.y);
    float nxy1 = mix(nx01, nx11, u.y);
    return mix(nxy0, nxy1, u.z);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pushData.count)) {
        return;
    }
    uint coordBase = id * 3u;
    vec3 p = vec3(inputCoords[coordBase], inputCoords[coordBase + 1u], inputCoords[coordBase + 2u]);
    uint base = id * 4u;

    float primary = valueNoise(p, 0x51ed270bu);
    float heightBias = (valueNoise(p * 0.5 + vec3(17.0, 29.0, 43.0), 0xa511e9b3u) * 2.0 - 1.0) * 0.5;
    float correction = valueNoise(p * 2.0 + vec3(71.0, 37.0, 11.0), 0x9e3779b9u);
    float flags = floor(valueNoise(p + vec3(101.0, 59.0, 23.0), 0x7f4a7c15u) * 16.0);

    outputFeatures[base] = primary;
    outputFeatures[base + 1u] = heightBias;
    outputFeatures[base + 2u] = correction;
    outputFeatures[base + 3u] = flags;
}
