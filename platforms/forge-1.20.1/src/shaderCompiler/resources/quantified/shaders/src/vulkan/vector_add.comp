#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer InA { float a[]; };
layout(std430, set = 0, binding = 1) readonly buffer InB { float b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer OutC { float c[]; };
layout(push_constant) uniform Push { int count; } pushData;
void main() {
    const uint ELEMENTS_PER_INVOCATION = 8u;
    uint base = gl_GlobalInvocationID.x * ELEMENTS_PER_INVOCATION;
    if (base + 7u < uint(pushData.count)) {
        c[base + 0u] = a[base + 0u] + b[base + 0u];
        c[base + 1u] = a[base + 1u] + b[base + 1u];
        c[base + 2u] = a[base + 2u] + b[base + 2u];
        c[base + 3u] = a[base + 3u] + b[base + 3u];
        c[base + 4u] = a[base + 4u] + b[base + 4u];
        c[base + 5u] = a[base + 5u] + b[base + 5u];
        c[base + 6u] = a[base + 6u] + b[base + 6u];
        c[base + 7u] = a[base + 7u] + b[base + 7u];
        return;
    }
    for (uint i = 0u; i < ELEMENTS_PER_INVOCATION; i++) {
        uint id = base + i;
        if (id < uint(pushData.count)) {
            c[id] = a[id] + b[id];
        }
    }
}
